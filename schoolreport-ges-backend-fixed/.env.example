# Local development: copy to .env (same folder) and fill in.
# Production on AWS: nothing to copy — infra/server/deploy.sh builds the settings from the
# stack's config parameter and Secrets Manager (see infra/README.md).

# ── Database (required) ─────────────────────────────────────────
# Either one URL…
DATABASE_URL=postgres://schoolreport:change-me@localhost:5432/schoolreport
# …or the standard PostgreSQL variables (production uses these):
# PGHOST=  PGPORT=5432  PGDATABASE=schoolreport  PGUSER=  PGPASSWORD=
# TLS with full certificate checking (required in production; RDS bundle ships in certs/):
# DATABASE_SSL_CA=certs/rds-global-bundle.pem
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=15000

# ── Auth (required) ─────────────────────────────────────────────
# At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── First superadmin (created on first start if none exists) ────
# Must be changed at first login. Required in production.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=

# ── Server ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Frontend address, used in email links (required in production)
FRONTEND_URL=http://localhost:5173
# Sites allowed to call the API, comma-separated (required in production)
# CORS_ORIGINS=https://your-frontend.vercel.app
# Number of proxies in front (CloudFront: 1). Defaults to 1 in production, 0 otherwise.
# TRUST_PROXY=1
# Secret header CloudFront adds; requests without it are refused (production)
# ORIGIN_VERIFY_SECRET=
# Requests per IP per minute (all API) / login + reset attempts per IP per 15 minutes
# API_RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20
# Logs: json (default in production) or text; level debug|info|warn|error
# LOG_FORMAT=json
# LOG_LEVEL=info

# ── Email (optional — without it, temporary passwords are only shown on screen) ──
# Amazon SES SMTP: host email-smtp.<region>.amazonaws.com, port 587 (TLS is required)
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true   # only for port 465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SchoolReport GES" <no-reply@your-domain>
