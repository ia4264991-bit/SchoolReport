# Copy to .env (same folder) and fill in. On Render/Railway set these in the dashboard instead.

# ── Database (required) ─────────────────────────────────────────
# PostgreSQL 13 or newer. Hosted databases usually need TLS: add ?sslmode=require
# (use ?sslmode=no-verify only if your provider's certificate is self-signed).
DATABASE_URL=postgres://schoolreport:change-me@localhost:5432/schoolreport
# PG_POOL_MAX=10

# ── Auth (required) ─────────────────────────────────────────────
# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── First superadmin (created on first start if none exists) ────
# Required in production. In development a default password is used if unset.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=

# ── Server ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Frontend address, used for links in emails
FRONTEND_URL=http://localhost:5173
# Comma-separated sites allowed to call the API (unset = any). Set this in production.
# CORS_ORIGINS=https://your-frontend.vercel.app
# Number of proxies in front of the server (Render/Railway: 1). Defaults to 1 in production.
# TRUST_PROXY=1
# Login / password-reset attempts per IP per 15 minutes
# AUTH_RATE_LIMIT_MAX=20

# ── Email (optional — without it, credentials are only shown on screen) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SchoolReport GES" <no-reply@example.com>
